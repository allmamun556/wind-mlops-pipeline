# Base URL of the FastAPI backend (backend/main.py). Copy to .env for local
# dev; docker-compose.yml sets this at build time for the production image.
VITE_API_URL=http://localhost:8000

# Cross-links to the other dashboards in this stack, shown in the header nav.
# Defaults match docker-compose.yml's local ports; override for a standalone
# deploy (e.g. Render service URLs).
VITE_GRAFANA_URL=http://localhost:3001/d/wind-power-monitoring/wind-power-prediction-e28094-model-monitoring?orgId=1&refresh=10s
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_MLFLOW_URL=http://localhost:5000/#/experiments/1/runs?workflowType=machine_learning&searchFilter=&orderByKey=attributes.start_time&orderByAsc=false&startTime=ALL&lifecycleFilter=Active&modelVersionFilter=All+Runs&datasetsFilter=W10%3D&compareRunsMode=TABLE
